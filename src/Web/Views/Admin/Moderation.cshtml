@*
    Admin Content Moderation — review flagged posts, reels, users, and groups.
*@
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Content Moderation";
    ViewData["CurrentPage"] = "Moderation";
}

<!-- Toast -->
<div id="toast" class="alert hidden"
     style="position:fixed;top:20px;right:20px;z-index:9999;min-width:260px;max-width:400px;display:flex;align-items:center;gap:10px;">
</div>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Content Moderation</h1>
        <p class="page-subtitle">Review and act on user-submitted reports</p>
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <select id="filterType" class="form-control form-select" style="width:150px;">
        <option value="">All Types</option>
        <option value="Post">Post</option>
        <option value="Reel">Reel</option>
        <option value="User">User</option>
        <option value="Group">Group</option>
    </select>
    <select id="filterStatus" class="form-control form-select" style="width:150px;">
        <option value="">All Status</option>
        <option value="Pending">Pending</option>
        <option value="Reviewed">Reviewed</option>
        <option value="Dismissed">Dismissed</option>
    </select>
    <div class="search-input-wrap" style="flex:0 0 180px;">
        <i class="ri-calendar-line"></i>
        <input type="date" id="filterFrom" class="form-control" placeholder="From" style="padding-left:34px;" />
    </div>
    <div class="search-input-wrap" style="flex:0 0 180px;">
        <i class="ri-calendar-line"></i>
        <input type="date" id="filterTo" class="form-control" placeholder="To" style="padding-left:34px;" />
    </div>
    <div class="filter-bar-right">
        <button id="btnResetFilter" class="btn btn-secondary btn-sm">
            <i class="ri-reset-right-line"></i> Reset
        </button>
        <button id="btnApplyFilter" class="btn btn-primary btn-sm">
            <i class="ri-filter-3-line"></i> Filter
        </button>
    </div>
</div>

<!-- Reports Table -->
<div class="card">
    <div class="card-body" style="padding:0;">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width:40px;"><input type="checkbox" id="checkAll" /></th>
                        <th>Type</th>
                        <th>Content</th>
                        <th>Author</th>
                        <th>Reason</th>
                        <th>Reports</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="reportsBody">
                    <tr>
                        <td colspan="9" class="text-center text-muted" style="padding:40px;">
                            <i class="ri-loader-4-line" style="font-size:1.5rem;"></i>
                            <br />Loading reports...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination">
            <span id="paginationInfo" class="pagination-info">—</span>
            <div id="paginationControls" class="pagination-controls"></div>
        </div>
    </div>
</div>

<!-- Bulk Action Bar -->
<div id="bulkActionBar" class="hidden"
     style="position:sticky;bottom:20px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:12px 18px;display:none;align-items:center;gap:12px;box-shadow:0 4px 16px rgba(0,0,0,.08);max-width:460px;margin:20px auto 0;">
    <span class="text-sm fw-600"><span id="bulkCount">0</span> selected</span>
    <div style="flex:1;"></div>
    <button class="btn btn-success btn-sm" onclick="Admin.Moderation.bulkResolve()"><i class="ri-checkbox-circle-line"></i> Mark Reviewed</button>
    <button class="btn btn-danger btn-sm" onclick="Admin.Moderation.bulkDismiss()"><i class="ri-forbid-2-line"></i> Dismiss</button>
</div>

<!-- ══════════════════════════════════════════════
     VIEW REPORT MODAL
     ══════════════════════════════════════════════ -->
<div class="modal-overlay hidden" id="viewModal">
    <div class="modal" style="max-width:560px;">
        <div class="modal-header">
            <h2 class="modal-title">Report Detail <span id="vmReportId" class="text-muted"></span></h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body">
            <!-- Flagged content preview -->
            <div>
                <div class="text-xs text-muted fw-600 mb-4" style="margin-bottom:6px;text-transform:uppercase;letter-spacing:.06em;color:var(--c-text-muted);">Flagged Content</div>
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;font-size:.875rem;line-height:1.6;min-height:48px;"
                     id="vmContent">—</div>
            </div>

            <!-- Grid of info -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px;">
                <div>
                    <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05em;">Author</div>
                    <div class="fw-600" id="vmAuthor">—</div>
                </div>
                <div>
                    <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05em;">Reason</div>
                    <div id="vmReason" class="fw-600">—</div>
                </div>
                <div>
                    <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05em;">Reporters</div>
                    <div class="fw-600" id="vmReporter">—</div>
                    <div class="text-xs text-muted" id="vmReportCount"></div>
                </div>
                <div>
                    <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05em;">Date</div>
                    <div class="fw-600" id="vmDate">—</div>
                </div>
                <div>
                    <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05em;">Status</div>
                    <div id="vmStatus">—</div>
                </div>
                <div>
                    <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05er;">Content ID</div>
                    <div class="fw-600 font-mono" id="vmContentId">—</div>
                </div>
            </div>

            <!-- Details if any -->
            <div id="vmDetailsWrap" style="margin-top:14px;display:none;">
                <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05em;">Reporter's Note</div>
                <div style="background:#fefce8;border:1px solid #fef08a;border-radius:6px;padding:10px 12px;font-size:.8375rem;color:#854d0e;margin-top:4px;" id="vmDetails"></div>
            </div>

            <!-- Review history — only shown when status is Reviewed / Dismissed -->
            <div id="vmHistoryWrap" style="margin-top:14px;display:none;">
                <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:.05em;">Review History</div>
                <div style="background:#f1f5f9;border:1px solid #e2e8f0;border-radius:6px;padding:10px 12px;font-size:.8375rem;color:#0f172a;margin-top:4px;line-height:1.5;">
                    <div><strong>Reviewed by:</strong> <span id="vmReviewedBy">—</span></div>
                    <div><strong>Reviewed at:</strong> <span id="vmReviewedAt">—</span></div>
                    <div id="vmReviewNoteWrap" style="margin-top:6px;display:none;">
                        <strong>Note:</strong> <span id="vmReviewNote"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Close</button>
            <button id="vmReviewBtn" class="btn btn-success" onclick="Admin.Moderation.openReviewFromView()"><i class="ri-checkbox-circle-line"></i> Review</button>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     REVIEW MODAL
     ══════════════════════════════════════════════ -->
<div class="modal-overlay hidden" id="reviewModal">
    <div class="modal">
        <div class="modal-header">
            <h2 class="modal-title">Review Report <span id="revReportId" class="text-muted"></span></h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body" style="display:flex;flex-direction:column;gap:16px;">

            <!-- Content preview -->
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px 14px;font-size:.875rem;line-height:1.5;color:var(--c-text-secondary);"
                 id="revContentPreview">—</div>

            <!-- Action on content -->
            <div class="form-group">
                <label class="form-label" for="revAction">Action on Content</label>
                <select id="revAction" class="form-control form-select">
                    <option value="0">No action on content</option>
                    @* Options added dynamically by JS based on content type *@
                </select>
                <span class="form-hint">Choose whether to lock or unlock the content, then confirm below.</span>
            </div>

            <!-- Dismiss toggle -->
            <div class="form-group">
                <label class="form-check">
                    <input type="checkbox" id="revDismiss" style="accent-color:var(--c-primary);" />
                    <span>Dismiss this report (no violation found)</span>
                </label>
            </div>

            <!-- Note -->
            <div class="form-group">
                <label class="form-label" for="revNote">Admin Note <span style="color:var(--c-text-muted);font-weight:400;">(optional)</span></label>
                <textarea id="revNote" class="form-control" rows="3"
                          placeholder="e.g. Content already removed by user, no further action needed..."></textarea>
            </div>

            <!-- Preview of what will happen -->
            <div id="revPreview" class="alert alert-info" style="display:none;">
                <i class="ri-information-line"></i>
                <span id="revPreviewText"></span>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Cancel</button>
            <button class="btn btn-success" onclick="Admin.Moderation.submitReview()">
                <i class="ri-checkbox-circle-line"></i> Confirm Review
            </button>
        </div>
    </div>
</div>

<form id="reviewFormFromView" style="display:none;"></form>

@section Scripts {
    <script src="~/admin/js/admin.moderation.js" asp-append-version="true"></script>
}
