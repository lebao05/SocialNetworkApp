@*
    Admin Content Moderation — review flagged posts, comments, and reports.
*@
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Content Moderation";
    ViewData["CurrentPage"] = "Moderation";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Content Moderation</h1>
        <p class="page-subtitle">Review flagged posts, comments, and user reports</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm">
            <i class="ri-history-line"></i>
            Moderation Log
        </button>
        <button class="btn btn-primary btn-sm">
            <i class="ri-settings-3-line"></i>
            Auto-Moderation Rules
        </button>
    </div>
</div>

<!-- Stats -->
<div class="stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:24px;">
    <div class="stat-card animate-in" style="padding:16px 18px;">
        <div class="stat-icon amber"><i class="ri-hourglass-line"></i></div>
        <div class="stat-info">
            <div class="stat-label">Pending</div>
            <div class="stat-value" style="font-size:1.4rem;">38</div>
        </div>
    </div>
    <div class="stat-card animate-in" style="padding:16px 18px;">
        <div class="stat-icon blue"><i class="ri-eye-line"></i></div>
        <div class="stat-info">
            <div class="stat-label">In Review</div>
            <div class="stat-value" style="font-size:1.4rem;">12</div>
        </div>
    </div>
    <div class="stat-card animate-in" style="padding:16px 18px;">
        <div class="stat-icon green"><i class="ri-shield-check-line"></i></div>
        <div class="stat-info">
            <div class="stat-label">Resolved Today</div>
            <div class="stat-value" style="font-size:1.4rem;">27</div>
        </div>
    </div>
    <div class="stat-card animate-in" style="padding:16px 18px;">
        <div class="stat-icon red"><i class="ri-alert-line"></i></div>
        <div class="stat-info">
            <div class="stat-label">False Reports</div>
            <div class="stat-value" style="font-size:1.4rem;">9</div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="search-input-wrap">
        <i class="ri-search-line"></i>
        <input type="text"
               class="form-control"
               placeholder="Search by post ID, content, or reporter..."
               style="min-width:280px;" />
    </div>
    <select class="form-control form-select" style="width:160px;">
        <option value="">All Types</option>
        <option>Post</option>
        <option>Comment</option>
        <option>User Profile</option>
        <option>Group</option>
    </select>
    <select class="form-control form-select" style="width:160px;">
        <option value="">All Reasons</option>
        <option>Hate speech</option>
        <option>Spam</option>
        <option>Harassment</option>
        <option>Misinformation</option>
        <option>Inappropriate content</option>
        <option>Fake account</option>
    </select>
    <select class="form-control form-select" style="width:150px;">
        <option value="">All Status</option>
        <option>Pending</option>
        <option>In Review</option>
        <option>Resolved</option>
        <option>Dismissed</option>
    </select>
    <div class="filter-bar-right">
        <button class="btn btn-secondary btn-sm">
            <i class="ri-reset-right-line"></i>
            Reset
        </button>
        <button class="btn btn-primary btn-sm">
            <i class="ri-filter-3-line"></i>
            Filter
        </button>
    </div>
</div>

<!-- Tabs -->
<div class="tabs" role="tablist">
    <button class="tab active" data-tab-group="mod" data-tab="all">
        All Reports <span class="tab-badge">50</span>
    </button>
    <button class="tab" data-tab-group="mod" data-tab="pending">
        Pending <span class="tab-badge" style="background:#fef3c7;color:#92400e;">38</span>
    </button>
    <button class="tab" data-tab-group="mod" data-tab="review">
        In Review <span class="tab-badge">12</span>
    </button>
    <button class="tab" data-tab-group="mod" data-tab="resolved">
        Resolved <span class="tab-badge" style="background:#d1fae5;color:#065f46;">124</span>
    </button>
</div>

<!-- Reports Table -->
<div class="card">
    <div class="card-body" style="padding:0;">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width:40px;">
                            <input type="checkbox" />
                        </th>
                        <th>Type</th>
                        <th>Content</th>
                        <th>Author</th>
                        <th>Reason</th>
                        <th>Reporters</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var reports = new[] {
                            new {
                                Id = "R-001",
                                Type = "Post",
                                Content = "This is absolutely disgusting behavior. They deserve everything that's coming to them. #hate",
                                Author = "Le Van C",
                                AuthorEmail = "levanc@example.com",
                                Reason = "Hate speech",
                                ReasonClass = "badge-danger",
                                Reporters = 4,
                                Status = "Pending",
                                StatusBadge = "badge-pending",
                                Date = "12 min ago",
                                PostId = "89234",
                                Group = ""
                            },
                            new {
                                Id = "R-002",
                                Type = "Post",
                                Content = "[Image: inappropriate content] Buy followers here!! 10k for $5 — check my bio for the link",
                                Author = "Bot_8812",
                                AuthorEmail = "bot8812@example.com",
                                Reason = "Spam",
                                ReasonClass = "badge-warning",
                                Reporters = 2,
                                Status = "Pending",
                                StatusBadge = "badge-pending",
                                Date = "28 min ago",
                                PostId = "89211",
                                Group = ""
                            },
                            new {
                                Id = "R-003",
                                Type = "Comment",
                                Content = "You're such an idiot for thinking that. Go back to school.",
                                Author = "Nguyen Van D",
                                AuthorEmail = "nguyenvand@example.com",
                                Reason = "Harassment",
                                ReasonClass = "badge-danger",
                                Reporters = 3,
                                Status = "In Review",
                                StatusBadge = "badge-info",
                                Date = "1 hr ago",
                                PostId = "89102",
                                Group = "Tech Talk"
                            },
                            new {
                                Id = "R-004",
                                Type = "User",
                                Content = "Fake celebrity account impersonating [Celebrity Name]",
                                Author = "OfficialCeleb",
                                AuthorEmail = "officialceleb@example.com",
                                Reason = "Fake account",
                                ReasonClass = "badge-danger",
                                Reporters = 7,
                                Status = "In Review",
                                StatusBadge = "badge-info",
                                Date = "2 hr ago",
                                PostId = "",
                                Group = ""
                            },
                            new {
                                Id = "R-005",
                                Type = "Post",
                                Content = "Scientists say the earth is flat and NASA is lying to you. Wake up sheep! #flatearth",
                                Author = "FlatEarther99",
                                AuthorEmail = "flatearth@example.com",
                                Reason = "Misinformation",
                                ReasonClass = "badge-warning",
                                Reporters = 11,
                                Status = "Resolved",
                                StatusBadge = "badge-active",
                                Date = "3 hr ago",
                                PostId = "88990",
                                Group = ""
                            },
                            new {
                                Id = "R-006",
                                Type = "Group",
                                Content = "Group name: 'NSFW Content Only' — Description contains explicit adult content description",
                                Author = "Admin_G001",
                                AuthorEmail = "adming1@example.com",
                                Reason = "Inappropriate content",
                                ReasonClass = "badge-warning",
                                Reporters = 2,
                                Status = "Dismissed",
                                StatusBadge = "badge-inactive",
                                Date = "5 hr ago",
                                PostId = "",
                                Group = ""
                            },
                            new {
                                Id = "R-007",
                                Type = "Post",
                                Content = "Click here to win a FREE iPhone 15!! Limited time only!! https://bit.ly/fake-scam",
                                Author = "PrizeWinnerX",
                                AuthorEmail = "prizewinnerx@example.com",
                                Reason = "Spam",
                                ReasonClass = "badge-warning",
                                Reporters = 15,
                                Status = "Resolved",
                                StatusBadge = "badge-active",
                                Date = "1 day ago",
                                PostId = "88701",
                                Group = ""
                            },
                            new {
                                Id = "R-008",
                                Type = "Comment",
                                Content = "You're all wrong. Just delete your accounts and quit.",
                                Author = "TrollUser99",
                                AuthorEmail = "troll99@example.com",
                                Reason = "Harassment",
                                ReasonClass = "badge-danger",
                                Reporters = 1,
                                Status = "Dismissed",
                                StatusBadge = "badge-inactive",
                                Date = "1 day ago",
                                PostId = "88520",
                                Group = ""
                            },
                        };
                    }

                    @foreach (var r in reports)
                    {
                        var typeClass = r.Type switch {
                            "Post"    => "badge-danger",
                            "Comment" => "badge-warning",
                            "User"    => "badge-info",
                            "Group"   => "badge-pending",
                            _         => ""
                        };
                        var initials = string.Join("", r.Author.Split(' ').Select(w => w[0]));

                        <tr>
                            <td><input type="checkbox" /></td>
                            <td>
                                <span class="badge @typeClass">@r.Type</span>
                            </td>
                            <td style="max-width:260px;">
                                <div class="truncate" style="font-size:.8375rem;line-height:1.4;max-width:240px;"
                                     title="@r.Content">
                                    @r.Content
                                </div>
                                @if (!string.IsNullOrEmpty(r.Group))
                                {
                                    <div class="text-xs text-muted" style="margin-top:2px;">
                                        <i class="ri-group-line"></i> @r.Group
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="cell-user">
                                    <div class="cell-user-avatar">@initials</div>
                                    <div class="cell-user-info">
                                        <div class="cell-user-name">@r.Author</div>
                                        <div class="cell-user-email">@r.AuthorEmail</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @r.ReasonClass">@r.Reason</span>
                            </td>
                            <td class="cell-muted">
                                <div style="display:flex;align-items:center;gap:5px;">
                                    <span>@r.Reporters</span>
                                    @if (r.Reporters >= 5)
                                    {
                                        <i class="ri-fire-line text-danger" style="font-size:.85rem;" title="High report count"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge @r.StatusBadge"><span class="badge-dot"></span>@r.Status</span>
                            </td>
                            <td class="cell-muted">@r.Date</td>
                            <td>
                                <div class="cell-actions" style="justify-content:flex-end;">
                                    <button class="action-btn primary"
                                            title="View content"
                                            data-modal="viewReportModal">
                                        <i class="ri-eye-line"></i>
                                    </button>
                                    <button class="action-btn success"
                                            title="Approve / resolve"
                                            data-modal="resolveModal">
                                        <i class="ri-checkbox-circle-line"></i>
                                    </button>
                                    <button class="action-btn danger"
                                            title="Remove content"
                                            data-modal="removeModal">
                                        <i class="ri-delete-bin-line"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination">
            <span class="pagination-info">Showing 1–8 of 50 reports</span>
            <div class="pagination-controls">
                <button class="page-btn" disabled><i class="ri-arrow-left-s-line"></i></button>
                <button class="page-btn active">1</button>
                <button class="page-btn">2</button>
                <button class="page-btn">3</button>
                <span class="page-ellipsis">...</span>
                <button class="page-btn">7</button>
                <button class="page-btn"><i class="ri-arrow-right-s-line"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Action Bar -->
<div class="bulk-action-bar hidden"
     style="position:sticky;bottom:20px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:12px 18px;display:flex;align-items:center;gap:12px;box-shadow:0 4px 16px rgba(0,0,0,.08);max-width:420px;margin:0 auto;">
    <span class="text-sm fw-600"><span class="bulk-count">0</span> selected</span>
    <div style="flex:1;"></div>
    <button class="btn btn-success btn-sm"><i class="ri-checkbox-circle-line"></i> Resolve</button>
    <button class="btn btn-danger btn-sm"><i class="ri-delete-bin-line"></i> Remove</button>
</div>

<!-- View Report Modal -->
<div class="modal-overlay hidden" id="viewReportModal">
    <div class="modal" style="max-width:560px;">
        <div class="modal-header">
            <h2 class="modal-title">Report Detail — R-001</h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body">
            <div style="display:flex;flex-direction:column;gap:14px;">
                <div>
                    <div class="text-sm text-muted fw-600 mb-4" style="margin-bottom:6px;">Flagged Content</div>
                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;font-size:.875rem;line-height:1.6;">
                        "This is absolutely disgusting behavior. They deserve everything that's coming to them. #hate"
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <div class="text-sm text-muted">Author</div>
                        <div class="fw-600">Le Van C</div>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Reason</div>
                        <span class="badge badge-danger">Hate speech</span>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Reporters</div>
                        <div class="fw-600">4 users</div>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Reported At</div>
                        <div class="fw-600">12 min ago</div>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Post ID</div>
                        <div class="fw-600 font-mono text-sm">#89234</div>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Status</div>
                        <span class="badge badge-pending"><span class="badge-dot"></span>Pending</span>
                    </div>
                </div>
                <div>
                    <div class="text-sm text-muted fw-600 mb-4" style="margin-bottom:6px;">Report Reasons</div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        <span class="badge badge-danger">Hate speech</span>
                        <span class="badge badge-warning">Harassment</span>
                        <span class="badge badge-inactive">Offensive language</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Close</button>
            <button class="btn btn-success" data-modal-close><i class="ri-checkbox-circle-line"></i> Resolve</button>
            <button class="btn btn-danger"><i class="ri-delete-bin-line"></i> Remove</button>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div class="modal-overlay hidden" id="resolveModal">
    <div class="modal">
        <div class="modal-header">
            <h2 class="modal-title">Resolve Report</h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body">
            <div class="alert alert-success">
                <i class="ri-checkbox-circle-line"></i>
                Marking this report as resolved. No further action will be taken against the content.
            </div>
            <div class="form-group">
                <label class="form-label">Resolution</label>
                <select class="form-control form-select">
                    <option>False report — content is acceptable</option>
                    <option>Resolved — content already removed</option>
                    <option>Resolved — user warned</option>
                    <option>Duplicate report</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Admin Note</label>
                <textarea class="form-control" rows="3" placeholder="Optional note..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Cancel</button>
            <button class="btn btn-success"><i class="ri-checkbox-circle-line"></i> Confirm Resolution</button>
        </div>
    </div>
</div>

<!-- Remove Content Modal -->
<div class="modal-overlay hidden" id="removeModal">
    <div class="modal">
        <div class="modal-header">
            <h2 class="modal-title">Remove Content</h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body">
            <div class="alert alert-danger">
                <i class="ri-error-warning-line"></i>
                This action will permanently remove the content from the platform.
            </div>
            <div class="form-group">
                <label class="form-label">Removal Reason <span>*</span></label>
                <select class="form-control form-select">
                    <option>Terms of service violation</option>
                    <option>Hate speech</option>
                    <option>Harassment or bullying</option>
                    <option>Spam</option>
                    <option>Misinformation</option>
                    <option>Inappropriate content</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">
                    <input type="checkbox" style="accent-color:var(--c-primary);" />
                    Also ban the author
                </label>
            </div>
            <div class="form-group">
                <label class="form-label">Admin Note</label>
                <textarea class="form-control" rows="3" placeholder="Required note for audit trail..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Cancel</button>
            <button class="btn btn-danger"><i class="ri-delete-bin-line"></i> Remove Content</button>
        </div>
    </div>
</div>
