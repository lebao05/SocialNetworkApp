@*
    Admin Forgot Password — placeholder UI. The reset email flow is not
    implemented yet; this view exists so the route doesn't 500.
*@
@{
    Layout = "~/Views/Admin/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div style="text-align:center;margin-bottom:24px;">
    <i class="ri-mail-lock-line" style="font-size:2.4rem;color:var(--c-primary,#6366f1);"></i>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        <i class="ri-error-warning-line"></i>
        @TempData["Error"]
    </div>
}

<form class="login-form" method="post" action="@Url.Action("ForgotPassword", "Admin")">
    @Html.AntiForgeryToken()

    <p class="text-muted text-sm" style="margin-bottom:18px;text-align:center;">
        Enter the email address associated with your admin account and we'll send
        instructions to reset your password.
    </p>

    <div class="form-group">
        <label class="form-label" for="email">Email address</label>
        <div class="search-input-wrap">
            <i class="ri-mail-line"></i>
            <input type="email"
                   id="email"
                   name="email"
                   class="form-control"
                   placeholder="admin@socialhub.com"
                   required
                   autocomplete="email" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">
        <i class="ri-send-plane-line"></i>
        Send reset link
    </button>

    <div class="login-divider"></div>

    <a href="@Url.Action("Login", "Admin")" class="btn btn-secondary" style="width:100%;">
        <i class="ri-arrow-left-line"></i>
        Back to sign in
    </a>
</form>