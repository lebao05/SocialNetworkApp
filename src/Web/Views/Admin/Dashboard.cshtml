@*
    Admin Dashboard — overview with stats, activity, and system health.
*@
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["CurrentPage"] = "Dashboard";
}

<!-- Stats Row -->
<div class="stats-grid">

    <div class="stat-card animate-in">
        <div class="stat-icon blue">
            <i class="ri-user-follow-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Total Users</div>
            <div class="stat-value">48,231</div>
            <div class="stat-meta up">
                <i class="ri-arrow-up-line"></i>
                <span>+1,204 this month</span>
            </div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon green">
            <i class="ri-file-text-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Posts</div>
            <div class="stat-value">3.1M</div>
            <div class="stat-meta up">
                <i class="ri-arrow-up-line"></i>
                <span>+18.3% vs last month</span>
            </div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon amber">
            <i class="ri-message-3-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Comments</div>
            <div class="stat-value">12.7M</div>
            <div class="stat-meta up">
                <i class="ri-arrow-up-line"></i>
                <span>+5.2% this week</span>
            </div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon red">
            <i class="ri-notification-3-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Reports</div>
            <div class="stat-value">142</div>
            <div class="stat-meta down">
                <i class="ri-arrow-down-line"></i>
                <span>-8 pending review</span>
            </div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon cyan">
            <i class="ri-shield-check-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Active Groups</div>
            <div class="stat-value">892</div>
            <div class="stat-meta neutral">
                <i class="ri-checkbox-circle-line"></i>
                <span>No change</span>
            </div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon blue">
            <i class="ri-group-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Online Now</div>
            <div class="stat-value">1,847</div>
            <div class="stat-meta up">
                <i class="ri-arrow-up-line"></i>
                <span>+312 since 1h ago</span>
            </div>
        </div>
    </div>

</div>

<!-- Main content + sidebar -->
<div class="grid-sidebar">

    <!-- Left column -->
    <div>

        <!-- Posts Activity Chart -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">Posts &amp; Comments — Last 7 Days</div>
                    <div class="card-subtitle">Daily volume across the platform</div>
                </div>
                <select class="form-control form-select" style="width:140px;">
                    <option>Last 7 days</option>
                    <option>Last 30 days</option>
                    <option>Last 90 days</option>
                </select>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    @* Simple CSS bar chart *@
                    <div style="display:flex;align-items:flex-end;gap:8px;height:200px;padding-bottom:24px;border-bottom:2px solid #e2e8f0;position:relative;">
                        @{
                            var chartBars = new[] {
                                ("Mon", 68),
                                ("Tue", 82),
                                ("Wed", 75),
                                ("Thu", 91),
                                ("Fri", 110),
                                ("Sat", 134),
                                ("Sun", 120),
                            };
                        }
                        @foreach (var (day, height) in chartBars)
                        {
                            <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <span style="font-size:.7rem;font-weight:600;color:#64748b;">@height</span>
                                <div style="width:100%;height:@(height)px;background:#818cf8;border-radius:4px 4px 0 0;transition:height .4s ease;opacity:.85;" title="@day: @height posts"></div>
                                <span style="font-size:.7rem;color:#94a3b8;">@day</span>
                            </div>
                        }
                    </div>
                </div>
                <div style="display:flex;gap:20px;margin-top:16px;">
                    <div style="display:flex;align-items:center;gap:6px;font-size:.8rem;color:#64748b;">
                        <div style="width:12px;height:12px;background:#818cf8;border-radius:2px;"></div>
                        Posts
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;font-size:.8rem;color:#64748b;">
                        <div style="width:12px;height:12px;background:#34d399;border-radius:2px;"></div>
                        Comments
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Reports -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">Recent Reports</div>
                    <div class="card-subtitle">Flagged content awaiting review</div>
                </div>
                <a href="@Url.Action("Moderation", "Admin")" class="btn btn-secondary btn-sm">
                    View all
                    <i class="ri-arrow-right-line"></i>
                </a>
            </div>
            <div class="card-body" style="padding:0;">
                <ul class="activity-list" style="padding:0 18px;">
                    <li class="report-item">
                        <div class="report-icon" style="background:#fee2e2;color:#ef4444;">
                            <i class="ri-error-warning-line"></i>
                        </div>
                        <div class="report-info">
                            <div class="report-title">Hate speech in post #89234</div>
                            <div class="report-meta">Reported by 4 users &middot; 12 min ago</div>
                        </div>
                        <span class="badge badge-pending"><span class="badge-dot"></span>Pending</span>
                    </li>
                    <li class="report-item">
                        <div class="report-icon" style="background:#fef3c7;color:#f59e0b;">
                            <i class="ri-image-line"></i>
                        </div>
                        <div class="report-info">
                            <div class="report-title">Inappropriate image in group "Tech Talk"</div>
                            <div class="report-meta">Reported by 2 users &middot; 28 min ago</div>
                        </div>
                        <span class="badge badge-pending"><span class="badge-dot"></span>Pending</span>
                    </li>
                    <li class="report-item">
                        <div class="report-icon" style="background:#fee2e2;color:#ef4444;">
                            <i class="ri-spam-line"></i>
                        </div>
                        <div class="report-info">
                            <div class="report-title">Spam comment on post #88301</div>
                            <div class="report-meta">Reported by 1 user &middot; 1 hr ago</div>
                        </div>
                        <span class="badge badge-pending"><span class="badge-dot"></span>Pending</span>
                    </li>
                    <li class="report-item">
                        <div class="report-icon" style="background:#cffafe;color:#06b6d4;">
                            <i class="ri-user-follow-line"></i>
                        </div>
                        <div class="report-info">
                            <div class="report-title">Fake profile — "Celebrity Official"</div>
                            <div class="report-meta">Reported by 7 users &middot; 2 hr ago</div>
                        </div>
                        <span class="badge badge-active"><span class="badge-dot"></span>In Review</span>
                    </li>
                    <li class="report-item">
                        <div class="report-icon" style="background:#f1f5f9;color:#64748b;">
                            <i class="ri-file-warning-line"></i>
                        </div>
                        <div class="report-info">
                            <div class="report-title">Misinformation in post #87012</div>
                            <div class="report-meta">Reported by 3 users &middot; 3 hr ago</div>
                        </div>
                        <span class="badge badge-banned"><span class="badge-dot"></span>Dismissed</span>
                    </li>
                </ul>
            </div>
        </div>

    </div>

    <!-- Right column -->
    <div>

        <!-- System Health -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">System Health</div>
                    <div class="card-subtitle">Live monitoring</div>
                </div>
                <div class="badge badge-active"><span class="badge-dot"></span>All systems up</div>
            </div>
            <div class="card-body" style="padding:14px 18px;">
                <div class="health-grid">
                    <div class="health-item">
                        <span class="health-label">API Latency</span>
                        <span class="health-value text-success">42ms</span>
                    </div>
                    <div class="health-item">
                        <span class="health-label">Database</span>
                        <span class="health-value text-success">Healthy</span>
                    </div>
                    <div class="health-item">
                        <span class="health-label">Memory</span>
                        <span class="health-value text-warning">78%</span>
                    </div>
                    <div class="health-item">
                        <span class="health-label">CPU</span>
                        <span class="health-value text-success">34%</span>
                    </div>
                    <div class="health-item">
                        <span class="health-label">SignalR</span>
                        <span class="health-value text-success">Online</span>
                    </div>
                    <div class="health-item">
                        <span class="health-label">CDN</span>
                        <span class="health-value text-success">OK</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">Recent Activity</div>
                    <div class="card-subtitle">Platform events in real-time</div>
                </div>
            </div>
            <div class="card-body" style="padding:8px 18px;">
                <ul class="activity-list">
                    <li class="activity-item">
                        <div class="activity-dot green"></div>
                        <div class="activity-content">
                            <div class="activity-text">New user <strong>Nguyen Van A</strong> registered</div>
                            <div class="activity-time">2 min ago</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot blue"></div>
                        <div class="activity-content">
                            <div class="activity-text">Group <strong>"HCMUT Students"</strong> was created</div>
                            <div class="activity-time">7 min ago</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot amber"></div>
                        <div class="activity-content">
                            <div class="activity-text">Content report filed on post #89230</div>
                            <div class="activity-time">14 min ago</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot cyan"></div>
                        <div class="activity-content">
                            <div class="activity-text">Admin <strong>john&#64;admin.com</strong> banned user #4421</div>
                            <div class="activity-time">22 min ago</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot green"></div>
                        <div class="activity-content">
                            <div class="activity-text">Friend request between user #332 and #881 accepted</div>
                            <div class="activity-time">31 min ago</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot red"></div>
                        <div class="activity-content">
                            <div class="activity-text">Spam campaign detected — 12 accounts flagged</div>
                            <div class="activity-time">48 min ago</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot blue"></div>
                        <div class="activity-content">
                            <div class="activity-text">Post #89012 hit 1,000 reactions milestone</div>
                            <div class="activity-time">1 hr ago</div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">Quick Actions</div>
            </div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
                <a href="@Url.Action("Users", "Admin")" class="btn btn-secondary" style="justify-content:flex-start;">
                    <i class="ri-user-search-line"></i>
                    Search users
                </a>
                <a href="@Url.Action("Moderation", "Admin")" class="btn btn-secondary" style="justify-content:flex-start;">
                    <i class="ri-shield-flash-line"></i>
                    Review reports
                    <span class="badge badge-danger" style="margin-left:auto;">8</span>
                </a>
                <a href="#" class="btn btn-secondary" style="justify-content:flex-start;">
                    <i class="ri-mail-send-line"></i>
                    Send platform announcement
                </a>
                <a href="#" class="btn btn-secondary" style="justify-content:flex-start;">
                    <i class="ri-file-chart-line"></i>
                    Export analytics CSV
                </a>
            </div>
        </div>

    </div>
</div>
