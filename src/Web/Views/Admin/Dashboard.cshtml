@*
    Admin Dashboard — overview with stats, growth charts, and activity.
    Line charts are rendered as inline SVG so they require no JS library
    or external CSS — they look identical regardless of admin.min.css state.
*@
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["CurrentPage"] = "Dashboard";

    // Shared 7-day window — used by all three line charts.
    var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    // Sample data series (replace with real aggregates later).
    var userGrowth = new[] { 412, 438, 461, 489, 510, 548, 587 };      // new users / day
    var postVolume = new[] { 68, 82, 75, 91, 110, 134, 120 };          // posts / day
    var commentVolume = new[] { 220, 261, 247, 298, 342, 401, 378 };   // comments / day
}

<!-- Stats Row -->
<div class="stats-grid">

    <div class="stat-card animate-in">
        <div class="stat-icon blue">
            <i class="ri-user-follow-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Total Users</div>
            <div class="stat-value">48,231</div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon green">
            <i class="ri-file-text-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Posts</div>
            <div class="stat-value">3.1M</div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon red">
            <i class="ri-notification-3-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Reports</div>
            <div class="stat-value">142</div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon cyan">
            <i class="ri-shield-check-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Active Groups</div>
            <div class="stat-value">892</div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon blue">
            <i class="ri-group-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Online Now</div>
            <div class="stat-value">1,847</div>
        </div>
    </div>

</div>

<!-- Charts Row -->
<div style="max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;">

    <!-- User Growth (line) -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">User Growth — Last 7 Days</div>
                <div class="card-subtitle">New registrations per day</div>
            </div>
            <select class="form-control form-select" style="width:140px;">
                <option>Last 7 days</option>
                <option>Last 30 days</option>
                <option>Last 90 days</option>
            </select>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("~/Views/Admin/Shared/_LineChart.cshtml", new
            {
                Id          = "userGrowthChart",
                Days        = days,
                Values      = userGrowth,
                StrokeColor = "#3b82f6",
                FillColor   = "rgba(59, 130, 246, .18)",
                YAxisLabel  = "Users"
            })
        </div>
    </div>

    <!-- Posts (line) -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Posts — Last 7 Days</div>
                <div class="card-subtitle">Daily post volume</div>
            </div>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("~/Views/Admin/Shared/_LineChart.cshtml", new
            {
                Id          = "postsChart",
                Days        = days,
                Values      = postVolume,
                StrokeColor = "#10b981",
                FillColor   = "rgba(16, 185, 129, .18)",
                YAxisLabel  = "Posts"
            })
        </div>
    </div>

    <!-- Comments (line) -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Comments — Last 7 Days</div>
                <div class="card-subtitle">Daily comment volume</div>
            </div>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("~/Views/Admin/Shared/_LineChart.cshtml", new
            {
                Id          = "commentsChart",
                Days        = days,
                Values      = commentVolume,
                StrokeColor = "#f59e0b",
                FillColor   = "rgba(245, 158, 11, .18)",
                YAxisLabel  = "Comments"
            })
        </div>
    </div>

</div>