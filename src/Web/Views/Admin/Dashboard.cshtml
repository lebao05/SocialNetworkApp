@*
    Admin Dashboard — overview with stats, growth charts, and activity.
    All numbers are loaded via AJAX from /admin/api/stats/* (see AdminStatsController).
    The server-rendered SVG partials are kept as a fallback / no-JS path: when
    JavaScript is disabled the page renders an empty container per chart that
    admin.dashboard.js will hydrate as soon as it boots.
*@
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["CurrentPage"] = "Dashboard";
}

<!-- Stats Row -->
<div class="stats-grid">

    <div class="stat-card animate-in">
        <div class="stat-icon blue">
            <i class="ri-user-follow-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Total Users</div>
            <div class="stat-value" data-stat="total-users">—</div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon green">
            <i class="ri-file-text-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Posts</div>
            <div class="stat-value" data-stat="total-posts">—</div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon cyan">
            <i class="ri-shield-check-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Active Groups</div>
            <div class="stat-value" data-stat="active-groups">—</div>
        </div>
    </div>

    <div class="stat-card animate-in">
        <div class="stat-icon blue">
            <i class="ri-group-line"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Online Now</div>
            <div class="stat-value" data-stat="online-now">—</div>
        </div>
    </div>

</div>

<!-- Charts Row -->
<div style="max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;">

    <!-- User Growth (line) -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">User Growth — Last <span data-period-label="user-growth">7</span> Days</div>
                <div class="card-subtitle">New registrations per day</div>
            </div>
            <select class="form-control form-select" data-period="user-growth" style="width:140px;">
                <option value="7" selected>Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>
        <div class="card-body">
            <div class="line-chart-wrap" id="userGrowthChart">
                <div style="text-align:center;color:#94a3b8;padding:60px 0;font-size:.875rem;">Loading…</div>
            </div>
        </div>
    </div>

    <!-- Posts (line) -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Posts — Last <span data-period-label="post-volume">7</span> Days</div>
                <div class="card-subtitle">Daily post volume</div>
            </div>
            <select class="form-control form-select" data-period="post-volume" style="width:140px;">
                <option value="7" selected>Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>
        <div class="card-body">
            <div class="line-chart-wrap" id="postsChart">
                <div style="text-align:center;color:#94a3b8;padding:60px 0;font-size:.875rem;">Loading…</div>
            </div>
        </div>
    </div>

    <!-- Comments (line) -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Comments — Last <span data-period-label="comment-volume">7</span> Days</div>
                <div class="card-subtitle">Daily comment volume</div>
            </div>
            <select class="form-control form-select" data-period="comment-volume" style="width:140px;">
                <option value="7" selected>Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>
        <div class="card-body">
            <div class="line-chart-wrap" id="commentsChart">
                <div style="text-align:center;color:#94a3b8;padding:60px 0;font-size:.875rem;">Loading…</div>
            </div>
        </div>
    </div>

    <!-- Reels (stacked bar) -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Reels — Last <span data-period-label="reel-volume">7</span> Days</div>
                <div class="card-subtitle">Reels uploaded per day</div>
            </div>
            <select class="form-control form-select" data-period="reel-volume" style="width:140px;">
                <option value="7" selected>Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>
        <div class="card-body">
            <div class="stacked-bar-wrap" id="reelsChart">
                <div style="text-align:center;color:#94a3b8;padding:60px 0;font-size:.875rem;">Loading…</div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/admin/js/admin.dashboard.js" asp-append-version="true"></script>
}