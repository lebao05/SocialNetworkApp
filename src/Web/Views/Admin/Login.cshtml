@*
    Admin Login — standalone page (uses _LoginLayout, no sidebar).
*@
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign In";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        <i class="ri-error-warning-line"></i>
        @TempData["Error"]
    </div>
}

<form class="login-form" method="post" action="@Url.Action("LoginPost", "Admin")">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="form-label" for="email">Email address</label>
        <div class="search-input-wrap">
            <i class="ri-mail-line"></i>
            <input type="email"
                   id="email"
                   name="email"
                   class="form-control"
                   placeholder="admin@socialhub.com"
                   required
                   autocomplete="email" />
        </div>
    </div>

    <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <div class="search-input-wrap">
            <i class="ri-lock-line"></i>
            <input type="password"
                   id="password"
                   name="password"
                   class="form-control"
                   placeholder="Enter your password"
                   required
                   autocomplete="current-password" />
        </div>
    </div>

    <div class="flex" style="justify-content:space-between;align-items:center;">
        <label class="form-check">
            <input type="checkbox" name="rememberMe" value="true" />
            <span>Keep me signed in</span>
        </label>
        <a href="@Url.Action("ForgotPassword", "Admin")" class="text-sm text-primary fw-600">Forgot password?</a>
    </div>

    <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">
        <i class="ri-login-box-line"></i>
        Sign in
    </button>

    <div class="login-divider">or</div>

    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary" style="width:100%;justify-content:center;">
        <i class="ri-arrow-left-line"></i>
        Back to App
    </a>
</form>

<p class="login-footer text-sm text-muted">
    Protected by SocialHub Admin &copy; @DateTime.UtcNow.Year<br />
    <a href="@Url.Action("Privacy", "Home")">Privacy Policy</a> &middot;
    <a href="@Url.Action("Terms", "Home")">Terms of Service</a>
</p>
