@*
    Admin Login — single, focused sign-in page.
*@
@{
    Layout = "~/Views/Admin/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Sign In";
}

<style>
    .login-form .form-label {
        display: block;
        text-align: center;
        margin-bottom: 6px;
    }
    .login-form .search-input-wrap i {
        display: none;
    }
    .login-form .form-control {
        text-align: center;
        padding-left: 12px !important;
        padding-right: 12px !important;
    }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        <i class="ri-error-warning-line"></i>
        @TempData["Error"]
    </div>
}

<form class="login-form" method="post" action="@Url.Action("LoginPost", "Admin")">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="form-label" for="email">Email address</label>
        <div class="search-input-wrap">
            <i class="ri-mail-line"></i>
            <input type="email"
                   id="email"
                   name="email"
                   class="form-control"
                   placeholder="admin@socialhub.com"
                   required
                   autocomplete="email" />
        </div>
    </div>

    <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <div class="search-input-wrap">
            <i class="ri-lock-line"></i>
            <input type="password"
                   id="password"
                   name="password"
                   class="form-control"
                   placeholder="Enter your password"
                   required
                   autocomplete="current-password" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">
        <i class="ri-login-box-line"></i>
        Sign in
    </button>
</form>

<p class="login-footer text-sm text-muted" style="text-align:center;margin-top:18px;">
    &copy; @DateTime.UtcNow.Year SocialHub Admin
</p>