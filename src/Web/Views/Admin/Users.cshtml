@*
    Admin User Management — list, search, filter, and manage platform users.
    All data is loaded via AJAX from /admin/users/list (and lock/unlock
    endpoints). The hard-coded rows that used to live here were a UI mock;
    real users are fetched live so admin actions are reflected immediately.
*@
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
    ViewData["CurrentPage"] = "Users";

    var currentQuery  = Context.Request.Query["q"].ToString();
    var currentStatus = Context.Request.Query["status"].ToString();
    var currentRole   = Context.Request.Query["role"].ToString();
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">User Management</h1>
        <p class="page-subtitle">Search, filter, and manage all users on the platform</p>
    </div>
</div>


<!-- Filter Bar — submit triggers AJAX re-fetch via admin.users.js -->
<form id="usersFilterForm" data-admin-table="users">
    <div class="filter-bar">
        <div class="search-input-wrap">
            <i class="ri-search-line"></i>
            <input type="text"
                   name="q"
                   class="form-control"
                   placeholder="Search by name or email"
                   value="@currentQuery" />
        </div>
        <select name="status" class="form-control form-select" style="width:150px;">
            <option value=""          @string.IsNullOrEmpty(currentStatus) ? "selected" : "">All Status</option>
            <option value="unlocked"  @(currentStatus == "unlocked" ? "selected" : "")>Unlocked</option>
            <option value="locked"    @(currentStatus == "locked"   ? "selected" : "")>Locked</option>
        </select>
        <select name="role" class="form-control form-select" style="width:150px;">
            <option value=""          @string.IsNullOrEmpty(currentRole) ? "selected" : "">All Roles</option>
            <option value="user"      @(currentRole == "user"      ? "selected" : "")>User</option>
            <option value="moderator" @(currentRole == "moderator" ? "selected" : "")>Moderator</option>
            <option value="admin"     @(currentRole == "admin"     ? "selected" : "")>Admin</option>
        </select>
        <div class="filter-bar-right">
            <button type="button" class="btn btn-secondary btn-sm" id="usersResetBtn">
                <i class="ri-reset-right-line"></i>
                Reset
            </button>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="ri-filter-3-line"></i>
                Apply
            </button>
        </div>
    </div>
</form>


<!-- Table — rows are populated by admin.users.js -->
<div class="card">
    <div class="card-body" style="padding:0;">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width:40px;">
                            <input type="checkbox" />
                        </th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Posts</th>
                        <th>Joined</th>
                        <th>Last Active</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="usersTbody">
                    <tr><td colspan="8" style="text-align:center;padding:32px;color:#94a3b8;">Loading…</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination">
            <span class="pagination-info" id="usersPaginationInfo">Loading…</span>
            <div class="pagination-controls" id="usersPaginationControls">
                <!-- buttons rendered by JS -->
            </div>
        </div>
    </div>
</div>

<!-- Bulk Action Bar (hidden by default) -->
<div class="bulk-action-bar hidden"
     style="position:sticky;bottom:20px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:12px 18px;display:flex;align-items:center;gap:12px;box-shadow:0 4px 16px rgba(0,0,0,.08);max-width:400px;margin:0 auto;">
    <span class="text-sm fw-600"><span class="bulk-count">0</span> selected</span>
    <div style="flex:1;"></div>
    <button class="btn btn-secondary btn-sm">Lock selected</button>
    <button class="btn btn-primary btn-sm">Export selected</button>
</div>

<!-- User Detail Modal -->
<div class="modal-overlay hidden" id="userDetailModal">
    <div class="modal">
        <div class="modal-header">
            <h2 class="modal-title">User Profile</h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body">
            <div style="text-align:center;margin-bottom:20px;">
                <div class="cell-user-avatar" style="width:64px;height:64px;font-size:1.5rem;margin:0 auto 10px;">—</div>
                <h3 style="font-size:1.1rem;font-weight:700;" id="userDetailName">User</h3>
                <p style="color:#64748b;font-size:.85rem;" id="userDetailEmail">—</p>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div style="background:#f8fafc;padding:12px;border-radius:8px;">
                    <div class="text-muted text-sm">Role</div>
                    <div class="fw-600" id="userDetailRole">—</div>
                </div>
                <div style="background:#f8fafc;padding:12px;border-radius:8px;">
                    <div class="text-muted text-sm">Status</div>
                    <div class="fw-600" id="userDetailStatus">—</div>
                </div>
                <div style="background:#f8fafc;padding:12px;border-radius:8px;">
                    <div class="text-muted text-sm">Posts</div>
                    <div class="fw-600" id="userDetailPosts">0</div>
                </div>
                <div style="background:#f8fafc;padding:12px;border-radius:8px;">
                    <div class="text-muted text-sm">Joined</div>
                    <div class="fw-600" id="userDetailJoined">—</div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Close</button>
        </div>
    </div>
</div>

<!-- Lock User Modal (confirm prompt) -->
<div class="modal-overlay hidden" id="banUserModal">
    <div class="modal">
        <div class="modal-header">
            <h2 class="modal-title">Lock User</h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body">
            <div class="alert alert-warning" style="margin-bottom:16px;">
                <i class="ri-error-warning-line"></i>
                This action will immediately lock the user's access to the platform.
            </div>
            <p style="color:#64748b;font-size:.9rem;">
                Lock <strong id="banUserName">this user</strong>? You can unlock them at any time.
            </p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Cancel</button>
            <button class="btn btn-danger" id="banUserConfirm"><i class="ri-lock-line"></i> Confirm Lock</button>
        </div>
    </div>
</div>

<!-- Edit User Modal (placeholder; no backend yet) -->
<div class="modal-overlay hidden" id="editUserModal">
    <div class="modal">
        <div class="modal-header">
            <h2 class="modal-title">Edit User</h2>
            <button class="modal-close" data-modal-close><i class="ri-close-line"></i></button>
        </div>
        <div class="modal-body">
            <div style="display:flex;flex-direction:column;gap:14px;">
                <div class="form-group">
                    <label class="form-label">Role</label>
                    <select class="form-control form-select">
                        <option selected>User</option>
                        <option>Moderator</option>
                        <option>Admin</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select class="form-control form-select">
                        <option selected>Unlocked</option>
                        <option>Locked</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close>Cancel</button>
            <button class="btn btn-primary"><i class="ri-save-line"></i> Save Changes</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/admin.users.js" asp-append-version="true"></script>
}