@*
    Full-page layout for the login screen — no sidebar.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - SocialHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/admin/css/admin.min.css" asp-append-version="true" />
</head>
<body class="login-body">

<div class="login-shell">
    <div class="login-panel">
        <div class="login-brand">
            <div class="login-brand-icon">
                <i class="ri-global-fill"></i>
            </div>
            <h1 class="login-brand-name">SocialHub</h1>
            <p class="login-brand-sub">Admin Portal</p>
        </div>

        @RenderBody()
    </div>

    <div class="login-artwork">
        <div class="artwork-content">
            <div class="artwork-stats">
                <div class="artwork-stat">
                    <span class="artwork-stat-num">12.4k</span>
                    <span class="artwork-stat-label">Active Users</span>
                </div>
                <div class="artwork-stat">
                    <span class="artwork-stat-num">98.2%</span>
                    <span class="artwork-stat-label">Uptime</span>
                </div>
                <div class="artwork-stat">
                    <span class="artwork-stat-num">3.1M</span>
                    <span class="artwork-stat-label">Posts / mo</span>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>
