@*
    Full-page layout for the login screen — centered, single column.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - SocialHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/admin/css/admin.min.css" asp-append-version="true" />
    <style>
        /* Single-column login: no right-side figures or marketing panel. */
        .login-shell {
            display: grid;
            grid-template-columns: minmax(0, 420px);
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 24px;
        }
        .login-artwork { display: none !important; }
        .login-panel {
            width: 100%;
            max-width: 420px;
            padding: 40px 32px;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .12);
            background: #fff;
        }
    </style>
</head>
<body class="login-body">

<div class="login-shell">
    <div class="login-panel">
        <div class="login-brand" style="text-align:center;margin-bottom:28px;">
            <div class="login-brand-icon">
                <i class="ri-global-fill"></i>
            </div>
            <h1 class="login-brand-name">SocialHub</h1>
            <p class="login-brand-sub">Admin Portal</p>
        </div>

        @RenderBody()
    </div>

    <!-- The right-side marketing panel is intentionally not rendered. -->
</div>

</body>
</html>