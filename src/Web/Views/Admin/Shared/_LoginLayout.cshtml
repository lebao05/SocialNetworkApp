@*
    Full-page layout for the login screen — centered, single column.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - SocialNet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/admin/css/admin.min.css" asp-append-version="true" />
    <style>
        /* Single-column login: no right-side figures or marketing panel. */
        .login-shell {
            display: grid;
            grid-template-columns: minmax(0, 420px);
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 24px;
        }
        .login-artwork { display: none !important; }
        .login-panel {
            width: 100%;
            max-width: 420px;
            padding: 40px 32px;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .12);
            background: #fff;
        }
    </style>
</head>
<body class="login-body">

<div class="login-shell">
    <div class="login-panel">
        <div class="login-brand" style="text-align:center;margin-bottom:28px;">
            <div class="login-brand-icon">
                <svg width="48" height="48" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display:inline-block;">
                    <defs>
                        <linearGradient id="socialnetLoginLogoGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#4F8BFF" />
                            <stop offset="50%" stop-color="#6366F1" />
                            <stop offset="100%" stop-color="#8B5CF6" />
                        </linearGradient>
                    </defs>
                    <path d="M14 8h36c5.523 0 10 4.477 10 10v22c0 5.523-4.477 10-10 10H30l-12 10c-.97.808-2.4.05-2.4-1.27V50h-1.6c-5.523 0-10-4.477-10-10V18c0-5.523 4.477-10 10-10z" fill="url(#socialnetLoginLogoGrad)" />
                    <path d="M32 41c-7.18 0-13-4.43-13-9.9 0-2.96 1.86-5.6 4.84-7.4a1.6 1.6 0 0 1 2.24 1.96c-.4 1.04-.08 2.07.86 2.74 1.74 1.24 5.06 1.24 6.8 0 .94-.67 1.26-1.7.86-2.74a1.6 1.6 0 0 1 2.24-1.96c2.98 1.8 4.84 4.44 4.84 7.4 0 5.47-5.82 9.9-13 9.9z" fill="#fff" />
                </svg>
            </div>
            <h1 class="login-brand-name">SocialNet</h1>
            <p class="login-brand-sub">Admin Portal</p>
        </div>

        @RenderBody()
    </div>

    <!-- The right-side marketing panel is intentionally not rendered. -->
</div>

</body>
</html>