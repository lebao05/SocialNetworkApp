@*
    Shared admin layout — wraps every authenticated admin page.
    Brings in the sidebar, topbar, and page content area.
*@
@{
    var currentPage = ViewData["CurrentPage"]?.ToString() ?? "";
    var adminName = Context.Session.GetString("AdminName") ?? "Admin";
    var adminAvatar = Context.Session.GetString("AdminAvatar") ?? "";
    var adminRole = Context.Session.GetString("AdminRole") ?? "Administrator";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Social Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/admin/css/admin.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="admin-shell">

    <!-- ===== SIDEBAR ===== -->
    <aside class="admin-sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <svg width="32" height="32" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display:block;">
                    <defs>
                        <linearGradient id="socialnetLogoGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#4F8BFF" />
                            <stop offset="50%" stop-color="#6366F1" />
                            <stop offset="100%" stop-color="#8B5CF6" />
                        </linearGradient>
                    </defs>
                    <path d="M14 8h36c5.523 0 10 4.477 10 10v22c0 5.523-4.477 10-10 10H30l-12 10c-.97.808-2.4.05-2.4-1.27V50h-1.6c-5.523 0-10-4.477-10-10V18c0-5.523 4.477-10 10-10z" fill="url(#socialnetLogoGrad)" />
                    <path d="M32 41c-7.18 0-13-4.43-13-9.9 0-2.96 1.86-5.6 4.84-7.4a1.6 1.6 0 0 1 2.24 1.96c-.4 1.04-.08 2.07.86 2.74 1.74 1.24 5.06 1.24 6.8 0 .94-.67 1.26-1.7.86-2.74a1.6 1.6 0 0 1 2.24-1.96c2.98 1.8 4.84 4.44 4.84 7.4 0 5.47-5.82 9.9-13 9.9z" fill="#fff" />
                </svg>
            </div>
            <span class="brand-name">SocialNet</span>
            <span class="brand-badge">Admin</span>
        </div>

        <div class="sidebar-section-label">Main</div>
        <nav class="sidebar-nav">
            <a class="nav-item @(currentPage == "Dashboard" ? "active" : "")"
               href="@Url.Action("Dashboard", "Admin")">
                <i class="ri-dashboard-line"></i>
                <span>Dashboard</span>
            </a>
            <a class="nav-item @(currentPage == "Users" ? "active" : "")"
               href="@Url.Action("Users", "Admin")">
                <i class="ri-user-line"></i>
                <span>Users</span>
            </a>
            <a class="nav-item @(currentPage == "Groups" ? "active" : "")"
               href="@Url.Action("Groups", "Admin")">
                <i class="ri-group-line"></i>
                <span>Groups</span>
            </a>
            <a class="nav-item @(currentPage == "Moderation" ? "active" : "")"
               href="@Url.Action("Moderation", "Admin")">
                <i class="ri-shield-check-line"></i>
                <span>Moderation</span>
            </a>
        </nav>

        @* <div class="sidebar-section-label">Analytics</div>
        <nav class="sidebar-nav">
            <a class="nav-item @(currentPage == "AuditLogs" ? "active" : "")"
               href="@Url.Action("AuditLogs", "Admin")">
                <i class="ri-file-list-3-line"></i>
                <span>Audit Logs</span>
            </a>
        </nav> *@

        <div class="sidebar-footer">
            <form asp-action="Logout" asp-controller="Admin" asp-area="" method="post">
                <button type="submit" class="nav-item nav-btn">
                    <i class="ri-logout-box-r-line"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ===== MAIN AREA ===== -->
    <div class="admin-main">

        <!-- Topbar -->
        <header class="admin-topbar">
            <button class="topbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                <i class="ri-menu-line"></i>
            </button>

            <div class="topbar-breadcrumb">
                <span class="breadcrumb-root">Admin</span>
                @if (!string.IsNullOrEmpty(currentPage) && currentPage != "Dashboard")
                {
                    <i class="ri-arrow-right-s-line"></i>
                    <span class="breadcrumb-current">@System.Text.RegularExpressions.Regex.Replace(currentPage, "([a-z])([A-Z])", "$1 $2")</span>
                }
            </div>

            <div class="topbar-actions">
                <div class="topbar-divider"></div>
                <div class="topbar-profile">
                    <div class="profile-avatar">
                        @if (!string.IsNullOrEmpty(adminAvatar))
                        {
                            <img src="@adminAvatar" alt="@adminName" />
                        }
                        else
                        {
                            <span>@adminName[0]</span>
                        }
                    </div>
                    <div class="profile-info">
                        <span class="profile-name">@adminName</span>
                        <span class="profile-role">@adminRole</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="admin-content">
            @RenderBody()
        </main>

    </div>
</div>

<script src="~/admin/js/admin.core.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
