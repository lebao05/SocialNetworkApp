@*
    Admin Group Management — list, search, filter, and manage platform groups.
    Mirrors Users.cshtml: rows are populated via AJAX, lock/unlock is wired
    to /admin/groups/{id}/lock and /unlock.
*@
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Groups";
    ViewData["CurrentPage"] = "Groups";

    var currentQuery   = Context.Request.Query["q"].ToString();
    var currentPrivacy = Context.Request.Query["privacy"].ToString();
    var currentStatus  = Context.Request.Query["status"].ToString();
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Group Management</h1>
        <p class="page-subtitle">Search, filter, and manage all groups on the platform</p>
    </div>
</div>


<!-- Filter Bar -->
<form id="groupsFilterForm" data-admin-table="groups">
    <div class="filter-bar">
        <div class="search-input-wrap">
            <i class="ri-search-line"></i>
            <input type="text"
                   name="q"
                   class="form-control"
                   placeholder="Search by name or description"
                   value="@currentQuery" />
        </div>
        <select name="privacy" class="form-control form-select" style="width:150px;">
            <option value=""         @string.IsNullOrEmpty(currentPrivacy) ? "selected" : "">All Privacy</option>
            <option value="public"   @(currentPrivacy == "public"  ? "selected" : "")>Public</option>
            <option value="private"  @(currentPrivacy == "private" ? "selected" : "")>Private</option>
        </select>
        <select name="status" class="form-control form-select" style="width:150px;">
            <option value=""          @string.IsNullOrEmpty(currentStatus) ? "selected" : "">All Status</option>
            <option value="unlocked"  @(currentStatus == "unlocked"  ? "selected" : "")>Unlocked</option>
            <option value="locked"    @(currentStatus == "locked"    ? "selected" : "")>Locked</option>
        </select>
        <div class="filter-bar-right">
            <button type="button" class="btn btn-secondary btn-sm" id="groupsResetBtn">
                <i class="ri-reset-right-line"></i>
                Reset
            </button>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="ri-filter-3-line"></i>
                Apply
            </button>
        </div>
    </div>
</form>


<!-- Table -->
<div class="card">
    <div class="card-body" style="padding:0;">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width:40px;">
                            <input type="checkbox" />
                        </th>
                        <th>Group</th>
                        <th>Privacy</th>
                        <th>Members</th>
                        <th>Posts</th>
                        <th>Owner</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="groupsTbody">
                    <tr><td colspan="9" style="text-align:center;padding:32px;color:#94a3b8;">Loading…</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination">
            <span class="pagination-info" id="groupsPaginationInfo">Loading…</span>
            <div class="pagination-controls" id="groupsPaginationControls">
                <!-- buttons rendered by JS -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/admin.groups.js" asp-append-version="true"></script>
}